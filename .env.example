# Project Interceptor - Environment Variables
PORT=8000
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# Commander assistant model guide — proxied server-side as POST /api/guide (dev + preview).
# The API key stays out of the browser bundle. MODEL is any OpenAI-compatible model id.
MODEL=gemini-3.8-flash
MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_API_KEY=

